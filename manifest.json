{
  "manifest_version": 3,
  "name": "Windchill Shortcuts",
  "version": "1.0.0",
  "description": "Adds Windchill-specific context-menu shortcuts that open pages in new tabs.",
  "permissions": ["tabs", "contextMenus"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Windchill Shortcuts",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}